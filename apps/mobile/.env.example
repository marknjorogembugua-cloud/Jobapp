# Your machine's LAN IP:3000/v1, not localhost, when testing on a physical device via Expo Go.
EXPO_PUBLIC_API_URL="http://localhost:3000/v1"

# Firebase web app config — Firebase console > Project settings > General > Your apps > Web app
EXPO_PUBLIC_FIREBASE_API_KEY=""
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=""
EXPO_PUBLIC_FIREBASE_PROJECT_ID=""
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=""
EXPO_PUBLIC_FIREBASE_SENDER_ID=""
EXPO_PUBLIC_FIREBASE_APP_ID=""
